#!/usr/bin/env bash
#
# tammo-powersaver - Zorin OS-style power profiles for tammoOS
#
# Usage:
#   tammo-powersaver status                               show the active power profile
#   tammo-powersaver set power-saver|balanced|performance  choose a profile
#   tammo-powersaver toggle                               flip between balanced and power-saver
#
# The backend is picked automatically:
#   power-profiles-daemon  on tammoOS 2.x (Ubuntu 24.04 base) - the backend Zorin OS uses
#   TLP                   on tammoOS 1.x (Ubuntu 18.04 base)
#   direct sysfs tweaks   on anything else

set -euo pipefail

STATE_DIR="/var/lib/tammo-powersaver"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<'EOF'
tammo-powersaver - Zorin OS-style power profiles for tammoOS

Usage:
  tammo-powersaver status                              show the active power profile
  tammo-powersaver set power-saver|balanced|performance
  tammo-powersaver toggle                              flip between balanced and power-saver

Profiles (like Zorin OS Settings -> Power):
  power-saver    save battery at the cost of performance
  balanced       everyday default
  performance    maximum speed, higher power draw
EOF
    exit "${1:-0}"
}

backend() {
    if have powerprofilesctl; then echo "power-profiles-daemon"
    elif have tlp; then echo "TLP"
    else echo "sysfs"
    fi
}

current_profile() {
    if have powerprofilesctl; then
        powerprofilesctl get 2>/dev/null || echo balanced
    else
        cat "$STATE_DIR/profile" 2>/dev/null || echo balanced
    fi
}

battery_info() {
    local bat cap stat out=""
    for bat in /sys/class/power_supply/BAT*; do
        [[ -r $bat/capacity ]] || continue
        cap="$(<"$bat/capacity")"
        stat="$(<"$bat/status")"
        out="${out:+$out }${cap}% (${stat,,})"
    done
    printf '%s' "$out"
}

cmd_status() {
    local bat
    echo "Power profile: $(current_profile)   [backend: $(backend)]"
    bat="$(battery_info)"
    [[ -n $bat ]] && echo "Battery:       $bat"
    return 0
}

notify() { # notify <title> <message>
    local title=$1 msg=$2 user=${SUDO_USER:-${USER:-}} uid
    have notify-send || return 0
    { [[ -n $user && $user != root ]] ; } || return 0
    uid="$(id -u "$user" 2>/dev/null)" || return 0
    runuser -u "$user" -- env \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
        notify-send -a tammoOS -i battery "$title" "$msg" 2>/dev/null || true
}

become_root_for_set() { # become_root_for_set <profile>
    local profile=$1
    if [[ -t 0 ]]; then
        exec sudo "$SELF" set "$profile"
    else
        exec pkexec "$SELF" set "$profile"
    fi
}

cmd_set() {
    local profile=${1:-}
    case $profile in
        power-saver|balanced|performance) ;;
        *)
            echo "Unknown profile: ${profile:-<none>}" >&2
            usage 1
            ;;
    esac

    local be
    be="$(backend)"

    case $be in
        power-profiles-daemon)
            powerprofilesctl set "$profile"
            ;;
        TLP)
            if [[ ${EUID} -ne 0 ]]; then become_root_for_set "$profile"; fi
            case $profile in
                power-saver) tlp bat ;; # force battery-optimised settings, even on AC
                *)           tlp ac ;;
            esac
            if [[ $profile == performance ]]; then
                echo "Note: TLP has no separate performance mode; 'balanced' was applied."
            fi
            ;;
        sysfs)
            if [[ ${EUID} -ne 0 ]]; then become_root_for_set "$profile"; fi
            sysfs_set "$profile"
            ;;
    esac

    mkdir -p "$STATE_DIR"
    echo "$profile" > "$STATE_DIR/profile"
    notify "tammoOS Power Saver" "Power profile set to ${profile}"
    echo "Power profile set to: ${profile}   [backend: ${be}]"
}

cmd_toggle() {
    if [[ $(current_profile) == power-saver ]]; then
        cmd_set balanced
    else
        cmd_set power-saver
    fi
}

# Fallback backend: apply the same knobs power-profiles-daemon uses.
sysfs_set() {
    local profile=$1 gov cpu dev mode_usb mode_sata mode_pci

    # remember the default CPU governor the first time we run
    if [[ ! -f $STATE_DIR/default-governor ]]; then
        mkdir -p "$STATE_DIR"
        cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null \
            > "$STATE_DIR/default-governor" || echo ondemand > "$STATE_DIR/default-governor"
    fi

    case $profile in
        power-saver)
            gov="powersave"
            mode_usb="auto" ; mode_sata="min_power" ; mode_pci="auto"
            ;;
        performance)
            gov="performance"
            mode_usb="on" ; mode_sata="max_performance" ; mode_pci="on"
            ;;
        *)
            gov="$(<"$STATE_DIR/default-governor")"
            mode_usb="auto" ; mode_sata="medium_power" ; mode_pci="auto"
            ;;
    esac

    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        [[ -w $cpu/cpufreq/scaling_governor ]] && \
            echo "$gov" > "$cpu/cpufreq/scaling_governor" 2>/dev/null || true
    done
    for dev in /sys/bus/usb/devices/*/power/control; do
        [[ -w $dev ]] && echo "$mode_usb" > "$dev" 2>/dev/null || true
    done
    for dev in /sys/class/scsi_host/host*/link_power_management_policy; do
        [[ -w $dev ]] && echo "$mode_sata" > "$dev" 2>/dev/null || true
    done
    for dev in /sys/bus/pci/devices/*/power/control; do
        [[ -w $dev ]] && echo "$mode_pci" > "$dev" 2>/dev/null || true
    done
    if [[ -w /sys/module/snd_hda_intel/parameters/power_save ]]; then
        echo 10 > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true
    fi
}

case ${1:-} in
    status)                         cmd_status ;;
    set)                            shift; cmd_set "$@" ;;
    toggle)                         cmd_toggle ;;
    power-saver|balanced|performance) cmd_set "$1" ;;
    -h|--help|help)                 usage 0 ;;
    *)                              usage 1 ;;
esac
