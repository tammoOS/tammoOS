[Desktop Entry]
Type=Application
Name=tammoOS Power Saver
GenericName=Power Profile Switcher
Comment=Switch the power profile (Power Saver, Balanced, Performance) like Zorin OS
Comment[de]=Energieprofil umschalten (Stromsparen, Ausgeglichen, Leistung) wie bei Zorin OS
Exec=tammo-powersaver toggle
Terminal=true
Icon=preferences-system-power
Categories=Settings;System;
Keywords=power;battery;saver;profile;zorin;energy;
StartupNotify=true
